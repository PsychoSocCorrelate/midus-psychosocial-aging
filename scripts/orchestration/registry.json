{
  "version": "2026-05-27",
  "policy": {
    "default_mode": "dry-run",
    "execute_flag": "--execute",
    "heavy_guard": "--include-heavy",
    "optional_guard": "--include GROUP",
    "raw_output_boundary": "Individual-level data is never tracked. .gitignore encodes the boundary: data/ is ignored except three canonical key maps and two raw-data READMEs; under output/ only *.csv is tracked, and shap_raw/** never is.",
    "versioning": "The commit that last changed this file is the registry's version. The top-level version field is a fixed label and is not bumped."
  },
  "steps": [
    {
      "id": "raw_inputs_check",
      "group": "preprocess",
      "role": "Raw-input presence check",
      "kind": "check_exists",
      "default": true,
      "heavy": false,
      "description": "Check that the raw MIDUS and IGEMS files and the key maps required for preprocessing are present.",
      "inputs": [],
      "outputs": [
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "data/raw/wave1/M2_P3_BTACT_N4512_20211123.sav",
        "data/raw/wave1/MR1_P3_BTACT_N2763_20251119.SAV",
        "data/raw/wave2/M3_P1_SURVEY_N3294_20251029.sav",
        "data/raw/wave2/MR2_P1_SURVEY_N2154_20251003.sav",
        "data/raw/wave2/M3_P3_BTACT_N3291_20210922.sav",
        "data/raw/wave2/MR2_P3_BTACT+MOCA_N1934_20260224.sav",
        "data/raw/biomarker/M2_BIO_AGGREGATE_N1255_20240405.sav",
        "data/raw/biomarker/M2_BIO_MEDICATION_STACKED_N7174_20240404.SAV",
        "data/raw/biomarker/M3_BIO_AGGREGATE_N747_20231016.sav",
        "data/raw/biomarker/M3_BIO_MEDICATION_STACKED_N5751_20231016.SAV",
        "data/raw/biomarker/MR1_BIO_AGGREGATE_N863_20240405.sav",
        "data/raw/biomarker/MR1_BIO_MEDICATION_STACKED_N5118_20240404.sav",
        "data/raw/biomarker/M2MR1_GEN_DNAmAge_N2118_20230822.sav",
        "data/raw/admin_midus_20nov2024.sav",
        "data/raw/mortality/MIDUS_Core_MortalityCauseData_N2822_20260511.sav",
        "data/raw/mortality/MIDUS_Refresher_MortalityCauseData_N454_20260511.sav",
        "data/key_map/midus2R_key_extended.xlsx",
        "data/key_map/midus2_industry_label_map_key.csv",
        "data/key_map/frailty/frailty_key_MIDUS_canonical.xlsx"
      ]
    },
    {
      "id": "qc_wave1",
      "group": "preprocess",
      "role": "Wave-1 survey preprocessing",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build pooled Wave-1 survey preprocessing file.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.survey.qc_pipeline",
        "--wave",
        "1"
      ],
      "inputs": [
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "data/key_map/midus2R_key_extended.xlsx",
        "data/key_map/midus2_industry_label_map_key.csv",
        "config/variable_config.yaml"
      ],
      "outputs": [
        "data/processed/wave1/all_M2MR_py.csv"
      ]
    },
    {
      "id": "qc_wave2",
      "group": "preprocess",
      "role": "Wave-2 survey preprocessing",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build pooled Wave-2 survey preprocessing file.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.survey.qc_pipeline",
        "--wave",
        "2"
      ],
      "inputs": [
        "data/raw/wave2/M3_P1_SURVEY_N3294_20251029.sav",
        "data/raw/wave2/MR2_P1_SURVEY_N2154_20251003.sav",
        "data/key_map/midus2R_key_extended.xlsx",
        "config/variable_config.yaml"
      ],
      "outputs": [
        "data/processed/wave2/all_M3MR2_py.csv"
      ]
    },
    {
      "id": "cfa_composites",
      "group": "preprocess",
      "role": "Composite scoring",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Fit CFA composites and write composite scores.",
      "command": [
        "Rscript",
        "preprocess/composites/cfa_composites.R"
      ],
      "inputs": [
        "data/processed/wave1/all_M2MR_py.csv",
        "data/processed/wave2/all_M3MR2_py.csv"
      ],
      "outputs": [
        "data/processed/shared/composite_cfa_scores.csv",
        "data/processed/shared/composite_cfa_fit.csv",
        "data/processed/shared/composite_align_fit.csv"
      ]
    },
    {
      "id": "analysis_ready_inputs",
      "group": "preprocess",
      "role": "Analysis-ready input assembly",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Join CFA composites and write analysis-ready Wave-1/Wave-2 inputs.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.qa.build_analysis_ready"
      ],
      "inputs": [
        "data/processed/wave1/all_M2MR_py.csv",
        "data/processed/wave2/all_M3MR2_py.csv",
        "data/processed/shared/composite_cfa_scores.csv"
      ],
      "outputs": [
        "data/processed/wave1/all_M2MR_analysis.csv",
        "data/processed/wave2/all_M3MR2_analysis.csv"
      ]
    },
    {
      "id": "cognition_longitudinal",
      "group": "preprocess",
      "role": "Cognition outcome build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build per-cohort cognition files. The longitudinal frame is used for the summary and not written.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.cognition.build_cog_longitudinal"
      ],
      "inputs": [
        "data/raw/wave1/M2_P3_BTACT_N4512_20211123.sav",
        "data/raw/wave1/MR1_P3_BTACT_N2763_20251119.SAV",
        "data/raw/wave2/M3_P3_BTACT_N3291_20210922.sav",
        "data/raw/wave2/MR2_P3_BTACT+MOCA_N1934_20260224.sav"
      ],
      "outputs": [
        "data/processed/cognition/cog_M2.csv",
        "data/processed/cognition/cog_M3.csv",
        "data/processed/cognition/cog_MR1.csv",
        "data/processed/cognition/cog_MR2.csv"
      ]
    },
    {
      "id": "frailty_wave1",
      "group": "preprocess",
      "role": "Wave-1 frailty outcome build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build Wave-1 frailty scores.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.frailty.frailty_pipeline",
        "--wave",
        "1"
      ],
      "inputs": [
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "data/key_map/frailty/frailty_key_MIDUS_canonical.xlsx"
      ],
      "outputs": [
        "data/processed/wave1/midus2_frailty.csv",
        "data/processed/wave1/midusr_frailty.csv",
        "data/processed/wave1/pooled_frailty_M2R.csv"
      ]
    },
    {
      "id": "frailty_wave2",
      "group": "preprocess",
      "role": "Wave-2 frailty outcome build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build Wave-2 frailty scores.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.frailty.frailty_pipeline",
        "--wave",
        "2"
      ],
      "inputs": [
        "data/raw/wave2/M3_P1_SURVEY_N3294_20251029.sav",
        "data/raw/wave2/MR2_P1_SURVEY_N2154_20251003.sav",
        "data/key_map/frailty/frailty_key_MIDUS_canonical.xlsx"
      ],
      "outputs": [
        "data/processed/wave2/midus3_frailty.csv",
        "data/processed/wave2/mr2_frailty.csv",
        "data/processed/wave2/pooled_frailty_M3MR2.csv"
      ]
    },
    {
      "id": "allostatic_load",
      "group": "preprocess",
      "role": "Allostatic-load outcome build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build the per-wave allostatic-load composite and the wave-1 reference it is scored against.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.biomarkers.allostatic_load"
      ],
      "inputs": [
        "data/raw/biomarker/M2_BIO_AGGREGATE_N1255_20240405.sav",
        "data/raw/biomarker/M2_BIO_MEDICATION_STACKED_N7174_20240404.SAV",
        "data/raw/biomarker/M3_BIO_AGGREGATE_N747_20231016.sav",
        "data/raw/biomarker/M3_BIO_MEDICATION_STACKED_N5751_20231016.SAV",
        "data/raw/biomarker/MR1_BIO_AGGREGATE_N863_20240405.sav",
        "data/raw/biomarker/MR1_BIO_MEDICATION_STACKED_N5118_20240404.sav"
      ],
      "outputs": [
        "data/processed/biomarker/allostatic_load_M2.csv",
        "data/processed/biomarker/allostatic_load_M3.csv",
        "data/processed/biomarker/allostatic_load_MR1.csv",
        "data/processed/biomarker/al_reference_wave1.csv"
      ]
    },
    {
      "id": "dnam_age",
      "group": "preprocess",
      "role": "DNAm age outcome build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build residualized DNAm age clocks for Wave-1 core and refresher samples.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.biomarkers.dnam_age"
      ],
      "inputs": [
        "data/raw/biomarker/M2MR1_GEN_DNAmAge_N2118_20230822.sav",
        "data/processed/wave1/all_M2MR_analysis.csv"
      ],
      "outputs": [
        "data/processed/biomarker/dnam_age_residualized.csv"
      ]
    },
    {
      "id": "master_analysis",
      "group": "build",
      "role": "Primary master dataset build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build the primary master analysis file.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.master.build_master_dataset"
      ],
      "inputs": [
        "data/processed/wave1/all_M2MR_analysis.csv",
        "data/processed/wave2/all_M3MR2_analysis.csv",
        "data/processed/cognition/cog_M2.csv",
        "data/processed/cognition/cog_MR1.csv",
        "data/processed/cognition/cog_M3.csv",
        "data/processed/cognition/cog_MR2.csv",
        "data/processed/wave1/pooled_frailty_M2R.csv",
        "data/processed/wave2/midus3_frailty.csv",
        "data/processed/wave2/mr2_frailty.csv",
        "data/processed/biomarker/allostatic_load_M2.csv",
        "data/processed/biomarker/allostatic_load_MR1.csv",
        "data/processed/biomarker/allostatic_load_M3.csv",
        "data/processed/biomarker/dnam_age_residualized.csv",
        "data/raw/admin_midus_20nov2024.sav",
        "data/raw/wave2/M3_P1_SURVEY_N3294_20251029.sav",
        "data/raw/wave2/MR2_P1_SURVEY_N2154_20251003.sav",
        "data/key_map/midus2R_key_extended.xlsx"
      ],
      "outputs": [
        "data/processed/master_analysis.csv"
      ]
    },
    {
      "id": "master_concurrent",
      "group": "build",
      "role": "Concurrent master dataset build",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Build the concurrent Wave-2 predictor master file.",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "preprocess.master.build_master_concurrent"
      ],
      "inputs": [
        "data/processed/wave2/all_M3MR2_analysis.csv",
        "data/processed/wave1/all_M2MR_py.csv",
        "data/processed/wave1/all_M2MR_analysis.csv",
        "data/processed/wave1/pooled_frailty_M2R.csv",
        "data/processed/cognition/cog_M2.csv",
        "data/processed/cognition/cog_MR1.csv",
        "data/processed/cognition/cog_M3.csv",
        "data/processed/cognition/cog_MR2.csv",
        "data/processed/wave2/midus3_frailty.csv",
        "data/processed/wave2/mr2_frailty.csv",
        "data/processed/biomarker/allostatic_load_M2.csv",
        "data/processed/biomarker/allostatic_load_MR1.csv",
        "data/processed/biomarker/allostatic_load_M3.csv",
        "data/raw/admin_midus_20nov2024.sav",
        "config/variable_config.yaml"
      ],
      "outputs": [
        "data/processed/master_analysis_concurrent.csv"
      ]
    },
    {
      "id": "d1_descriptive",
      "group": "analyses",
      "role": "Primary descriptive layer",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Descriptives, attrition, reliability, and change-score source outputs.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/d1_descriptive.py"
      ],
      "outputs": [
        "output/d1_descriptive/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv"
      ]
    },
    {
      "id": "cs1_cross_sectional",
      "group": "analyses",
      "role": "Primary prediction layer",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Wave-1 cross-sectional models and SHAP for the paper.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/cs1_cross_sectional.py"
      ],
      "outputs": [
        "output/cs1_cross_sectional/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv"
      ]
    },
    {
      "id": "a4_longitudinal",
      "group": "analyses",
      "role": "Primary longitudinal layer",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Primary baseline-conditioned longitudinal models.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a4_longitudinal.py"
      ],
      "outputs": [
        "output/a4_longitudinal/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv",
        "output/cs1_cross_sectional"
      ]
    },
    {
      "id": "a7_mortality_primary",
      "group": "analyses",
      "role": "External endpoint validation",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Primary Cox validation using through-2025 mortality endpoint.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a7_mortality.py"
      ],
      "outputs": [
        "output/a7_mortality/a7_endpoint_summary.csv",
        "output/a7_mortality/a7_c_index_table.csv"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv",
        "data/raw/mortality/MIDUS_Core_MortalityCauseData_N2822_20260511.sav",
        "data/raw/mortality/MIDUS_Refresher_MortalityCauseData_N454_20260511.sav",
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "output/a4_longitudinal"
      ]
    },
    {
      "id": "a7_mortality_fixed9",
      "group": "analyses",
      "role": "Endpoint-window sensitivity",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Fixed 9-year Cox validation sensitivity.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a7_mortality.py",
        "--endpoint",
        "fixed_9y"
      ],
      "outputs": [
        "output/a7_mortality/fixed_9y_sensitivity/a7_endpoint_summary.csv"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv",
        "data/raw/mortality/MIDUS_Core_MortalityCauseData_N2822_20260511.sav",
        "data/raw/mortality/MIDUS_Refresher_MortalityCauseData_N454_20260511.sav",
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "output/a4_longitudinal"
      ]
    },
    {
      "id": "a4b_concurrent_sensitivity",
      "group": "analyses",
      "role": "Timing sensitivity",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Concurrent W2 predictor sensitivity.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a4b_longitudinal.py"
      ],
      "outputs": [
        "output/a4b_longitudinal/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv",
        "output/a4_longitudinal"
      ]
    },
    {
      "id": "a6_family_decomposition",
      "group": "analyses",
      "role": "Primary family-comparison layer",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Sibling/twin between-within decomposition.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a6_sibling_decomposition.py"
      ],
      "outputs": [
        "output/a6_sibling/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/wave1/pooled_frailty_M2R.csv",
        "data/processed/wave2/pooled_frailty_M3MR2.csv",
        "output/a4_longitudinal",
        "output/cs1_cross_sectional"
      ]
    },
    {
      "id": "within_family_mde",
      "group": "analyses",
      "role": "Within-family power and minimum detectable effects",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Minimum detectable effects and power for the within-family layer.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/within_family_mde.py"
      ],
      "outputs": [
        "output/within_family_mde/within_family_mde.csv",
        "output/within_family_mde/within_family_mde_summary.csv",
        "output/within_family_mde/within_family_mde_concurrent.csv",
        "output/within_family_mde/within_family_mde_concurrent_summary.csv",
        "output/within_family_mde/within_family_mde_reference.csv"
      ],
      "inputs": [
        "output/a6_sibling"
      ]
    },
    {
      "id": "al_twins_heldout",
      "group": "analyses",
      "role": "Allostatic-load models with twin pairs held out",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Refit the allostatic-load composite's cross-sectional and change Tier 2 increments and top-20 with every complete sibling/twin pair dropped from training, the one outcome whose twins otherwise straddle folds, and compare with cs1 and a4.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/sensitivity/al_twins_heldout.py"
      ],
      "outputs": [
        "output/al_twins_heldout/al_twins_heldout_summary.csv",
        "output/al_twins_heldout/al_twins_heldout_top20.csv",
        "output/al_twins_heldout/ALcomp_W1_heldout_bootstrap_shap.csv"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "output/cs1_cross_sectional/cs1_r2_table.csv",
        "output/a4_longitudinal/a4_r2_table.csv",
        "output/cs1_cross_sectional/shap"
      ]
    },
    {
      "id": "outcome_correlations_by_wave",
      "group": "analyses",
      "role": "Outcome correlations by wave",
      "kind": "command",
      "default": true,
      "heavy": false,
      "description": "Age-residualized outcome correlations at each wave, with Fisher-z intervals (SI Table S15).",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/outcome_correlations_by_wave.py"
      ],
      "outputs": [
        "output/outcome_correlations_by_wave/outcome_correlations_by_wave.csv",
        "output/outcome_correlations_by_wave/outcome_correlations_by_wave_formatted.csv"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "output/d1_descriptive"
      ]
    },
    {
      "id": "a11_mortality_shap",
      "group": "analyses",
      "role": "Mortality model interpretation",
      "kind": "command",
      "default": true,
      "heavy": true,
      "description": "Primary mortality SHAP and CV.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a11_mortality_shap.py"
      ],
      "outputs": [
        "output/a11_mortality_shap/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv",
        "data/raw/mortality/MIDUS_Core_MortalityCauseData_N2822_20260511.sav",
        "data/raw/mortality/MIDUS_Refresher_MortalityCauseData_N454_20260511.sav",
        "data/raw/wave1/M2_P1_SURVEY_N4963_20200720.sav",
        "data/raw/wave1/MR1_P1_SURVEY_N3577_20250407.sav",
        "output/cs1_cross_sectional"
      ]
    },
    {
      "id": "a12_delta_r2_ci",
      "group": "analyses",
      "role": "Delta-R2 interval estimation",
      "kind": "command",
      "default": false,
      "heavy": true,
      "description": "Repeated-CV intervals for the reported delta-R2 values. Repeat r uses random_state = 42 + r, so repeat 0 is the production seed and reproduces the point estimate. Writes every repeat as well as the summary, so other interval definitions can be computed without refitting. Off by default: the most expensive step.",
      "command": [
        "uv",
        "run",
        "python",
        "analysis/pipelines/a12_delta_r2_ci.py",
        "--shards",
        "2"
      ],
      "outputs": [
        "output/a12_delta_r2_ci/"
      ],
      "inputs": [
        "data/processed/master_analysis.csv",
        "data/processed/master_analysis_concurrent.csv"
      ]
    },
    {
      "id": "a2_frailty_overlap",
      "group": "analyses",
