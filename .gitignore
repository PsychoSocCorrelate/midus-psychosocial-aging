# Python and tool caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# R session files can hold participant rows
.Rhistory
.RData
.Rproj.user/
*.rdata
*.RData

# Editor and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Generated by the registry steps: figures, tables and run logs
manuscript/
logs/
*.log

# Step outputs: only the aggregate CSVs under output/ are tracked
output/**
!output/**/
!output/**/*.csv
output/**/*.md

# MIDUS data stays local: only the raw-data READMEs and the shared key maps are tracked.
# These rules come last so that no re-include above reaches an individual-level data path.
data/*
!data/raw/
data/raw/*
!data/raw/README.md
!data/raw/data_access.md
!data/key_map/
data/key_map/*
!data/key_map/midus2R_key_extended.xlsx
!data/key_map/midus2_industry_label_map_key.csv
!data/key_map/frailty/
data/key_map/frailty/*
!data/key_map/frailty/frailty_key_MIDUS_canonical.xlsx
output/**/shap_raw/**
